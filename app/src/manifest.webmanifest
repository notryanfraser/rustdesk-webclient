{
  "name": "rustdesk-web",
  "short_name": "rustdesk-web",
  "description": "Remote desktop through your own RustDesk server",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#15171a",
  "theme_color": "#1f2328",
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
