# Copy to .env and fill in. Never commit .env.

# The public hostname of your RustDesk server, exactly as you type it into the native
# RustDesk clients' "ID server" field (no https://, no port). Native clients, hbbs's relay
# setting and the web client all use this one name.
RUSTDESK_HOST=rustdesk.example.com

# hbbs's public key: the contents of ./data/id_ed25519.pub (created on hbbs's first start).
# This is the same "Key" the native clients use. It is a public key, not a password.
RUSTDESK_KEY=
